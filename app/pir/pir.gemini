ok etsi moiazei kalytera, alla ππαλι κατι χανουμε, δεν βεπωαντιστοιχηση τιμων με κινηση, σαν να ειναι τυχαιες
Το γεγονός ότι οι τιμές μοιάζουν ακόμα «τυχαίες» και δεν ανταποκρίνονται στην κίνηση επιβεβαιώνει τη συμπεριφορά του αισθητήρα: οι ψηφιακοί αισθητήρες YS332 / YS322 (16-bit ADC) δεν επιστρέφουν μια έτοιμη κατάσταση "κίνησης", αλλά την ακατέργαστη κυματομορφή (RAW AC signal) του πυροηλεκτρικού στοιχείου. 

Global Sources
 +1
Όταν είστε ακίνητος, η τιμή δεν μένει σταθερή. Ανεβοκατεβαίνει συνεχώς λόγω του εσωτερικού θορύβου (Offset / Bias). Όταν κουνιέστε, δημιουργείται μια στιγμιαία διακύμανση (ένα απότομο "κύμα" πάνω-κάτω). 

Polsri Repository
 +1
Για να βγάλετε νόημα, η JavaScript πρέπει να κάνει φιλτράρισμα (High-Pass / DC Tracking Filter). Πρέπει να κρατάει έναν κινητό μέσο όρο (Baseline), να βλέπει πόσο απέχει η τρέχουσα τιμή από αυτόν, και αν η διαφορά ξεπεράσει ένα όριο (Threshold), τότε να ενεργοποιεί την κίνηση. 

Arduino Help Center
Ο Τελικός Κώδικας με Φίλτρο Ανίχνευσης Κίνησης
Αυτός ο κώδικας κρατάει την Inline C σταθερή (χρησιμοποιώντας τη μάσκα 0x3FFF του STM32 που αποδείχτηκε ότι ευθυγραμμίζει καλύτερα τα bit) και αναλαμβάνει να «καθαρίσει» το σήμα στη JavaScript, τυπώνοντας "ΚΙΝΗΣΗ!" μόνο όταν συμβαίνει πραγματικό γεγονός.
javascript
const PIN_OUT = D24;   // P0.24 -> Data
const PIN_PWR = D32;   // P1.00 -> Power

var c = E.compiledC(`
// void initPIR()
// int readPIRRaw()

volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

void delay_3us() {
    for(volatile int i=0; i<12; i++) {
        __asm("nop");
    }
}

void initPIR() {
    *P1_PIN_CNF_0 = 1;       
    *P1_OUTSET = (1U << 0);  
}

int readPIRRaw() {
    unsigned int value = 0;

    // Start Signal: HIGH
    *P0_PIN_CNF_24 = 1; 
    *P0_OUTSET = (1U << 24);
    for (volatile int d = 0; d < 350; d++) {
        __asm("nop");
    }

    // Read 19 bits
    for (unsigned char i = 0; i < 19; i++) {
        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
        delay_3us();

        *P0_OUTSET = (1U << 24);
        delay_3us();

        *P0_PIN_CNF_24 = 0; 
        delay_3us();

        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }

        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
    }

    *P0_OUTCLR = (1U << 24);
    *P0_PIN_CNF_24 = 1;

    value = (value >> 1);
    value &= 0x3FFF; // Επαναφορά στη δοκιμασμένη μάσκα 14-bit

    return (int)value;
}
`);

// Μεταβλητές για το ψηφιακό φίλτρο στη JavaScript
var baseline = 8192;       // Το θεωρητικό κέντρο του 14-bit (0-16383)
var filterCoefficient = 0.95; // Πόσο γρήγορα προσαρμόζεται στο περιβάλλον
var threshold = 350;       // Είδος ευαισθησίας. Μειώστε το αν δεν πιάνει, αυξήστε αν χτυπάει μόνο του.

function startPIRTest() {
  c.initPIR();
  console.log("Αναμονή 10 δευτερολέπτων για καλιμπράρισμα του αισθητήρα...");
  console.log("Μη μετακινείστε από το πεδίο του αισθητήρα!");
  
  setTimeout(function() {
    console.log("Το φίλτρο ενεργοποιήθηκε. Ξεκινήστε τις δοκιμές κίνησης!");
    
    setInterval(function() {
      try {
        var rawVal = c.readPIRRaw();
        
        // 1. Υπολογισμός δυναμικής βάσης (Baseline) για να ακολουθεί τον θόρυβο
        baseline = (baseline * filterCoefficient) + (rawVal * (1 - filterCoefficient));
        
        // 2. Υπολογισμός της απόλυτης διαφοράς (AC Signal)
        var diff = Math.abs(rawVal - baseline);
        
        // 3. Έλεγχος αν ξεπερνάει το κατώφλι (Threshold)
        if (diff > threshold) {
          console.log("--> [ ΚΙΝΗΣΗ ΔΙΑΠΙΣΤΩΘΗΚΕ! ] (Διαφορά: " + Math.round(diff) + " | Raw: " + rawVal + ")");
        } else {
          // Προαιρετικό Log για να βλέπετε την ηρεμία του σήματος
          // console.log("Ήρεμο - Raw: " + rawVal + " Diff: " + Math.round(diff));
        }
        
      } catch(e) {
        console.log("Error: ", e);
      }
    }, 150); // Γρήγορο sampling στα 150ms
    
  }, 10000); // 10 δευτερόλεπτα αρχικό warm-up
}

startPIRTest();
Χρησιμοποιήστε τον κώδικα με προσοχή.
Πώς να το ρυθμίσετε:
Μόλις πατήσετε upload, μην κουνηθείτε για 10 δευτερόλεπτα ώστε να πάρει σωστές αρχικές τιμές το φίλτρο.
Μετά, κουνήστε το χέρι σας. Αν δείτε να τυπώνει [ ΚΙΝΗΣΗ ΔΙΑΠΙΣΤΩΘΗΚΕ! ], το σύστημα δουλεύει.
Αν είναι πολύ ευαίσθητο (βγάζει κίνηση ενώ είστε ακίνητος), αυξήστε τη μεταβλητή threshold σε 500 ή 700.
Αν δεν πιάνει καθόλου, κατεβάστε το threshold σε 200. 

