https://github.com/maurosmartins/nrf2mqtt/blob/main/firmware/Core/Inc/ys332.h

#ifndef INC_YS332_H_
#define INC_YS332_H_

#include "stm32g0xx_hal.h"

#define PIR_PORT GPIOA
#define PIR_PIN  GPIO_PIN_12

// Input mode
#define PIR_INPUT() \
    (PIR_PORT->MODER &= ~(3U << (12 * 2)))

// Output mode
#define PIR_OUTPUT() \
    do { \
        PIR_PORT->MODER &= ~(3U << (12 * 2)); \
        PIR_PORT->MODER |=  (1U << (12 * 2)); \
    } while (0)

// Drive low
#define PIR_LOW() \
    (PIR_PORT->BSRR = (1U << (12 + 16)))

// Drive high
#define PIR_HIGH() \
    (PIR_PORT->BSRR = (1U << 12))

// Read
#define PIR_READ() \
    ((PIR_PORT->IDR >> 12) & 1)


#define delay_5us() \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \


int16_t PIR_ReadRaw(void);
void vTimingTest_5us(void);



#endif /* INC_YS332_H_ */

https://github.com/maurosmartins/nrf2mqtt/blob/main/firmware/Core/Src/ys332.c

/*
 * ys332.c
 *
 *  Created on: Apr 6, 2026
 *      Author: mauro
 */

#include "ys332.h"

volatile int16_t PIR=0;

int16_t PIR_ReadRaw(void){
    uint32_t value = 0;
    int16_t pirRaw = 0;


    PIR_HIGH();
    PIR_OUTPUT();
    for (volatile int d = 0; d < 18; d++); //~110us


    for (uint8_t i = 0; i < 19; i++)
    {
        //Pull LOW
    	PIR_OUTPUT();
        PIR_LOW();

        delay_5us();

        //Rising edge
        PIR_HIGH();
        delay_5us();

        //wait for DOCI to switch state
		PIR_INPUT();
        delay_5us();

        //Read bit
        value <<= 1;
        if (PIR_READ() == GPIO_PIN_SET){
            value |= 1;
        }

        PIR_OUTPUT();
        PIR_LOW();

    }

    //pull low
    PIR_LOW();
    PIR_OUTPUT();


    value = (value >> 1);
    value &= 0b001111111111111111;

    pirRaw = value;

    return pirRaw;
}

void vTimingTest_5us(void){
	PIR_OUTPUT();
	while(1){
		PIR_LOW();
		delay_5us();
		PIR_HIGH();
		delay_5us();
	}
}

Με αυτα τα δεδομενα, και με τα ππαρακατω:

1). Χρησιμοποιουμε NRF52840
2). Το λογισμικό ειναι Espruino
3). To PIR  Ειναι συνδεδεενο στο NRF,  me to D24  στο OUT του πιρ, και το  D32  στο  power του PIR
4). To Esprino,  Exei δυνατότητα  Inline C :

https://www.espruino.com/InlineC

Inline C code⇠
Normal code for Espruino is written in JavaScript. However for some tasks this won't be fast enough, or you may have existing C code that you wish to use.

In this case, you have a few options:

Insert inline C code into your JS project
Recompile the Espruino firmware with your own C code
Use the IDE to compile your JavaScript code
Use the Inline Assembler
This page covers the first option - follow the links above for other options.

Note: This is an online service that is only provided for official Espruino boards. It won't work on devices like ESP8266 or ESP32.

How do I use it?⇠
You create code of the form var c = E.compiledC in the root scope of your code, giving your C code inside a 'template literal' (using the backtick character at the beginning and end).

var c = E.compiledC(`
// int fibo(int)
int fibo(int n){
 if(n <= 1){
  return n;
 }
 int fibo = 1;
 int fiboPrev = 1;
 for(int i = 2; i < n; ++i){
  int temp = fibo;
  fibo += fiboPrev;
  fiboPrev = temp;
 }
 return fibo;
}
`);

print(c.fibo(20));
The first lines should contain comments that describe the arguments and return value for each function that you wish to export to Espruino, in the same form as used for the Assembler. The variable c will then contain an object containing a field for each exported function.

Interrupts⇠
One of the main uses for Inline C is doing something when an interrupt occurs. You can do this by specifying irq:true when using setWatch:


var c = E.compiledC(`
// void press(bool)
// int get()
volatile int data;
void press(bool state){
  data++;
}
int get() {
 int r = data;
 data = 0;
 return r;
}
`);
// Make `c.press` get called on an IRQ
setWatch(c.press, BTN1, {repeat:true, edge:"both", irq:true});
// Every 10 seconds, report back the value
setInterval(function() {
  print(c.get());
}, 10000);
Note that you can have multiple functions and variables. While Espruino can't access the variables directly, you can write 'getter' functions for them.

Accessing arrays⇠
You'll probably want to use C code to work through large amounts of data quickly. To avoid fragmentation problems, it's not guaranteed that Espruino will always allocate data in one contiguous chunk, so you have two options:

forEach⇠
Use Array/TypedArray.forEach to call your function for each element of the array:

var c = E.compiledC(`
// void hash(int)
// int get()
unsigned int data;
void hash(unsigned int value){
  data = ((data<<1) | (data>>31)) ^ value;
}
int get() {
 int r = data;
 data = 0;
 return r;
}
`);

var arr = new Uint32Array(1000);
// Fill with random data
for (var i in arr) arr[i]=Math.random()*0xFFFFFFFF;
// Feed each data item through in turn
arr.forEach(c.hash);
// Print the result
print(c.get());
Note that you can also use .map, .reduce, .filter, etc.

Direct Access⇠
Large typed arrays (eg. Uint8Array) will always be allocated as Flat Strings if possible, but you can use E.toString to force Espruino to create a Flat String (a contiguous array of bytes) from whatever data is supplied as an argument.

Calling E.getAddressOf(variable, true) will return the physical address of the start of that variable's data, or 0 if the memory area is not flat. All you need to do is pass the address from E.getAddressOf into your C code as an integer and you can access the data as a normal array.

// Sum all items in the given array
var c = E.compiledC(`
// int sum(int, int)
int sum(int len, unsigned char *data){
  int s = 0;
  while (len--)
    s += *(data++);
  return s;
}
`);
// Allocate the data
var data = new Uint8Array(5000);
for (var i in data) data[i]=i;
// Get the address
var addr = E.getAddressOf(data,true);
if (!addr) throw new Error("Not a Flat String");
// Execute the function to sum
print(c.sum(data.length, addr));
Adding code to a module⇠
Adding inline C to a module is easy - just write the Inline C as you would normally do, then export it:

var c = E.compiledC(`
// double lookup(int)

double lut[8] = {
 41,42,43,44,45,46,47,48
};
double lookup(unsigned int x)
{
  return lut[x&7];
}
`);

exports = c;
(You can of course just export specific functions if you want to, for instance exports.lookup = c.lookup;)

The module itself will contain the C source code, but the IDE will detect the code on upload and will automatically compile it for the board you're uploading to.

What Happens?⇠
Before uploading, the Web IDE scans your code for calls of the form E.compiledC. It then sends those functions to our server which compiles that code with GCC and sends a location-independent binary back so that it can be uploaded to Espruino as a native function.

When you run this native function, the ARM processor in Espruino executes the compiled code directly (with no interpreter in the way). You should see an increase in execution speed of at least 100x for most tasks.

Caveats⇠
Arithmetic with floats, doubles and uint64 may not work since it requires functions that won't be compiled in.
There is no C preprocessor - so #define/etc won't work
Ctrl+C and Exception handling won't work. If there's a loop in your compiled function then you'll only be able to break out of it by resetting the board.
The code that is sent to the Espruino board is specific to that type of board and version of the Espruino firmware. To use it on a different board you'll need to send it again using the Web IDE.


Μπορρεις να μου φτιαεις ενα τεστ για  το Espruino, Να δω αν μπορω να διαβασω το Ματι?
Για να διαβάσεις το συγκεκριμένο PIR (τύπου YS332) στο Espruino με το nRF52840, πρέπει να μεταφέρουμε τη λογική των bit-banging παλμών από τον κώδικα STM32 σε Inline C, προσαρμόζοντάς την στους περιορισμούς του Espruino (όπου δεν επιτρέπονται #define και η πρόσβαση στα PIN γίνεται μέσω των registers του nRF52840).
Ακολουθεί ένας πλήρης, έτοιμος κώδικας για δοκιμή (test script) που μπορείς να φορτώσεις απευθείας στο Espruino Web IDE.
Ο Κώδικας για το Espruino
javascript
// 1. Ορισμός των Pins βάσει των προδιαγραφών σου
const PIN_OUT = D24;   // P0.24 (D24) -> Το data pin του PIR
const PIN_PWR = D32;   // P1.00 (D32) -> Το power pin του PIR

// 2. Inline C για τον nRF52840 (Χωρίς #define, με απευθείας registers)
var c = E.compiledC(`
// int readPIRRaw()

// Διευθύνσεις των GPIO Registers του nRF52840
// P0 (για το D24 / Port 0, Pin 24)
#define NRF_P0_BASE        0x50000000UL
#define P0_OUTSET          (*(volatile unsigned int *)(NRF_P0_BASE + 0x508))
#define P0_OUTCLR          (*(volatile unsigned int *)(NRF_P0_BASE + 0x50C))
#define P0_IN              (*(volatile unsigned int *)(NRF_P0_BASE + 0x510))
#define P0_PIN_CNF_24      (*(volatile unsigned int *)(NRF_P0_BASE + 0x760))

// Χειροκίνητη συνάρτηση delay (~5us) με NOPs
void delay_5us_nrf() {
    for(volatile int i=0; i<32; i++) {
        __asm("nop");
    }
}

int readPIRRaw() {
    unsigned int value = 0;

    // 1. PIN_OUT ως Output και HIGH για ~110us (Start Signal)
    P0_PIN_CNF_24 = 1; // Dir: Output, Input: Disconnect
    P0_OUTSET = (1U << 24);
    
    // Καθυστέρηση ~110us
    for (volatile int d = 0; d < 700; d++) {
        __asm("nop");
    }

    // 2. Ανάγνωση των 19 bits
    for (unsigned char i = 0; i < 19; i++) {
        // Pull LOW
        P0_PIN_CNF_24 = 1;
        P0_OUTCLR = (1U << 24);
        delay_5us_nrf();

        // Rising edge (HIGH)
        P0_OUTSET = (1U << 24);
        delay_5us_nrf();

        // Γύρισμα σε INPUT για να οδηγήσει τη γραμμή το PIR (DOCI)
        P0_PIN_CNF_24 = 0; // Dir: Input, Connect, No pull
        delay_5us_nrf();

        // Διάβασμα του bit
        value <<= 1;
        if ((P0_IN >> 24) & 1) {
            value |= 1;
        }

        // Επαναφορά σε LOW πριν το επόμενο bit
        P0_PIN_CNF_24 = 1;
        P0_OUTCLR = (1U << 24);
    }

    // 3. Τελικό Pull LOW στην έξοδο
    P0_OUTCLR = (1U << 24);
    P0_PIN_CNF_24 = 1;

    // Shift δεξιά κατά 1 bit και απομόνωση των 14 bits (όπως στον κώδικα STM32)
    value = (value >> 1);
    value &= 0x3FFF; // 0b0011111111111111

    return (int)value;
}
`);

// 3. Συνάρτηση αρχικοποίησης και ελέγχου σε JavaScript
function startPIRTest() {
  console.log("Ανάβω το PIR (D32)...");
  PIN_PWR.set(); // Δίνουμε ρεύμα στο PIR από το D32
  
  // Το PIR χρειάζεται χρόνο για να σταθεροποιηθεί (warm-up)
  console.log("Αναμονή 2 δευτερολέπτων για warm-up...");
  
  setTimeout(function() {
    console.log("Έναρξη καταγραφής δεδομένων (κάθε 500ms):");
    
    // Διάβασμα του αισθητήρα κάθε 500ms
    setInterval(function() {
      try {
        var rawVal = c.readPIRRaw();
        console.log("PIR Raw Value: " + rawVal);
      } catch(e) {
        console.log("Σφάλμα κατά την εκτέλεση της C: ", e);
      }
    }, 500);
    
  }, 2000);
}

// Εκτέλεση της δοκιμής
startPIRTest();
Χρησιμοποιήστε τον κώδικα με προσοχή.
Πώς λειτουργεί η μετατροπή στους Registers του nRF52840:
Αντιστοίχιση Pin: Το D24 στο Espruino αντιστοιχεί στο Port 0, Pin 24 του nRF52840 (P0.24).
P0_PIN_CNF_24: Είναι ο register παραμέτρων του συγκεκριμένου pin. Θέτοντάς τον σε 1 γίνεται Output. Θέτοντάς τον σε 0 γίνεται Input.
P0_OUTSET / P0_OUTCLR: Χρησιμοποιούνται για να κάνουμε ακαριαία το pin HIGH (1U << 24) ή LOW αντίστοιχα, χωρίς να επηρεάζουμε τα υπόλοιπα pins.
P0_IN: Διαβάζει την κατάσταση της θύρας, και με το >> 24 απομονώνουμε το bit που μας ενδιαφέρει.
Σημαντικές σημειώσεις για τη δοκιμή:
Web IDE: Πρέπει να χρησιμοποιήσεις το επίσημο Espruino Web IDE, καθώς αυτό στέλνει τον κώδικα Inline C στον server της Espruino για compilation.
Warm-up: Όταν το PIR (YS332) παίρνει ρεύμα, οι πρώτες μετρήσεις μπορεί να είναι ασταθείς ή στο μέγιστο όριο μέχρι να καλιμπραριστεί το «μάτι».
Τιμές: Αν όλα δουλεύουν σωστά, θα βλέπεις έναν αριθμό στην κονσόλα που θα αλλάζει απότομα όταν κουνάς το χέρι σου μπροστά από τον αισθητήρα.
Αν δεις ότι οι τιμές επιστρέφουν κολλημένες στο 0 ή στο 16383 (μέγιστο 14-bit), ενημέρωσέ με για να πειράξουμε τους χρόνους (delay) στην Inline C!
Οι απαντήσεις AI μπορεί να περιλαμβάνουν λάθη. Μάθετε περισσότερα




βγαζε ι αυτα τα λαθηη οταν τρεχει το αρχειο____ _| __|___ ___ ___ _ _|_|___ ___| __|_ -| . | _| | | | | . ||____|___| _|_| |___|_|_|_|___| |_| espruino.com 2v29.79 (c) 2026 G.WilliamsEspruino is Open Source. Our work is supportedonly by sales of official boards and donations:http://espruino.com/DonateAn Uncaught Error has been saved to Storage. Please type: require('Storage').read('ERROR') to view it require('Storage').erase('ERROR') to clear it[ COMPILER MESSAGE ] : tmp/out160285742.cpp: In function 'int readPIRRaw()':tmp/out160285742.cpp:78:5: error: 'P0_PIN_CNF_24' was not declared in this scope P0_PIN_CNF_24 = 1; // Dir: Output, Input: Disconnect ^tmp/out160285742.cpp:79:5: error: 'P0_OUTSET' was not declared in this scope P0_OUTSET = (1U << 24); ^tmp/out160285742.cpp:90:9: error: 'P0_OUTCLR' was not declared in this scope P0_OUTCLR = (1U << 24); ^tmp/out160285742.cpp:103:14: error: 'P0_IN' was not declared in this scope if ((P0_IN >> 24) & 1) { ^tmp/out160285742.cpp:113:5: error: 'P0_OUTCLR' was not declared in this scope P0_OUTCLR = (1U << 24); ^>
Το σφάλμα συμβαίνει επειδή ο compiler του Espruino server απορρίπτει τα #define μέσα στο σώμα του Inline C (όπως αναφέρεται και στα caveats: "There is no C preprocessor - so #define/etc won't work").
Για να το διορθώσουμε, πρέπει να αντικαταστήσουμε τα #define με κανονικούς δείκτες C (volatile unsigned int *).
Επίσης, επειδή το D32 ανήκει στο Port 1 (P1.00) του nRF52840, πρόσθεσα τη σωστή διαχείριση της τροφοδοσίας του απευθείας μέσα στην Inline C για να είμαστε σίγουροι ότι το Pin μένει σταθερά HIGH χωρίς παρεμβολές από το JavaScript.
Ορίστε ο διορθωμένος κώδικας χωρίς κανένα #define:
javascript
// 1. Ορισμός των Pins βάσει των προδιαγραφών σου
const PIN_OUT = D24;   // P0.24 -> Data
const PIN_PWR = D32;   // P1.00 -> Power

// 2. Inline C για τον nRF52840 (Χωρίς προεπεξεργαστή / #define)
var c = E.compiledC(`
// void initPIR()
// int readPIRRaw()

// Διευθύνσεις καταχωρητών nRF52840 GPIO
// Port 0 (για το D24 / P0.24)
volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

// Port 1 (για το D32 / P1.00)
volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

// Καθυστέρηση ~5us με NOPs
void delay_5us_nrf() {
    for(volatile int i=0; i<35; i++) {
        __asm("nop");
    }
}

// Αρχικοποίηση τροφοδοσίας από την C
void initPIR() {
    *P1_PIN_CNF_0 = 1;       // P1.00 (D32) ως Output
    *P1_OUTSET = (1U << 0);  // Power HIGH
}

int readPIRRaw() {
    unsigned int value = 0;

    // 1. PIN_OUT ως Output και HIGH για ~110us (Start Signal)
    *P0_PIN_CNF_24 = 1; 
    *P0_OUTSET = (1U << 24);
    
    // Καθυστέρηση ~110us
    for (volatile int d = 0; d < 750; d++) {
        __asm("nop");
    }

    // 2. Ανάγνωση των 19 bits
    for (unsigned char i = 0; i < 19; i++) {
        // Pull LOW
        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
        delay_5us_nrf();

        // Rising edge (HIGH)
        *P0_OUTSET = (1U << 24);
        delay_5us_nrf();

        // Γύρισμα σε INPUT (DOCI)
        *P0_PIN_CNF_24 = 0; 
        delay_5us_nrf();

        // Διάβασμα του bit
        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }

        // Επαναφορά σε LOW πριν το επόμενο bit
        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
    }

    // 3. Τελικό Pull LOW
    *P0_OUTCLR = (1U << 24);
    *P0_PIN_CNF_24 = 1;

    // Shift δεξιά κατά 1 bit και απομόνωση 14 bits
    value = (value >> 1);
    value &= 0x3FFF; 

    return (int)value;
}
`);

// 3. Διαχείριση και εκτέλεση στο Espruino
function startPIRTest() {
  console.log("Αρχικοποίηση PIR και παροχή ρεύματος...");
  c.initPIR(); // Άναμμα του PIR μέσω C
  
  console.log("Αναμονή 2 δευτερολέπτων για warm-up του αισθητήρα...");
  
  setTimeout(function() {
    console.log("Έναρξη μετρήσεων (κάθε 500ms):");
    
    setInterval(function() {
      try {
        var rawVal = c.readPIRRaw();
        console.log("PIR Raw Value: " + rawVal);
      } catch(e) {
        console.log("Σφάλμα ανάγνωσης: ", e);
      }
    }, 500);
    
  }, 2000);
}

// Εκκίνηση της δοκιμής
startPIRTest();
Χρησιμοποιήστε τον κώδικα με προσοχή.
Τι άλλαξε:
Αφαίρεση των #define: Αντικαταστάθηκαν με volatile unsigned int *指针 = (διεύθυνση) στην αρχή του C block.
Σωστή σύνταξη δεικτών: Μέσα στη συνάρτηση, η εγγραφή γίνεται με αστερίσκο (π.χ. *P0_OUTSET = ...).
Εγγυημένη τροφοδοσία: Η ενεργοποίηση του D32 γίνεται πλέον με register επιπέδου hardware (P1_OUTSET), αποτρέποντας τυχόν power-saving modes του Espruino να κλείσουν το pin.
Δοκίμασε να το ανεβάσεις ξανά. Αν σου εμφανίσει τιμές στην κονσόλα, κούνησε το χέρι σου μπροστά από τον αισθητήρα για να δεις αν οι τιμές μεταβάλλονται!
Οι απαντήσεις AI μπορεί να περιλαμβάνουν λάθη. Μάθετε περισσότερα



PIR Raw Value: 16382PIR Raw Value: 16382PIR Raw Value: 15056PIR Raw Value: 16192PIR Raw Value: 9344PIR Raw Value: 5120PIR Raw Value: 15472PIR Raw Value: 15712PIR Raw Value: 16192PIR Raw Value: 16348PIR Raw Value: 257PIR Raw Value: 513μοιαζει να βγαει τιμες τυχαια, δεν βλεπω σχεη με την κινησ, ακινητο ειναι και δεν με βλεπει, αλλα αλλλαζει νουμερα
Το γεγονός ότι παίρνεις νούμερα που αλλάζουν (από 16382 μέχρι 257) και δεν είναι κολλημένα στο απόλυτο μηδέν ή στο μέγιστο, δείχνει ότι η επικοινωνία bit-banging λειτουργεί! Το PIR στέλνει δεδομένα και ο nRF52840 τα διαβάζει.
Οι «τυχαίες» τιμές χωρίς κίνηση οφείλονται σε δύο πολύ συγκεκριμένους λόγους που έχουν να κάνουν με τη φύση των ψηφιακών PIR (τύπου YS332/EG4002):
1. Οι χρόνοι (Delays) της C είναι πολύ γρήγοροι στον nRF52840
Ο nRF52840 τρέχει στα 64 MHz [1]. Ο STM32 του αρχικού κώδικα μπορεί να έτρεχε πιο αργά ή να είχε διαφορετικό pipeline. Αν το delay_5us_nrf είναι στην πραγματικότητα 1-2 μικροδευτερόλεπτα, χάνουμε τον χρονισμό των bit (DOCI window) [1] και διαβάζουμε «θόρυβο».
2. Διαβάζεις την ακατέργαστη τιμή του εσωτερικού ADC (Raw PIR)
Το ψηφιακό PIR δεν βγάζει 0 ή 1 (κίνηση/όχι κίνηση). Μέσα από το σειριακό πρωτόκολλο, σου στέλνει την ακατέργαστη τιμή της τάσης του εσωτερικού πυροηλεκτρικού στοιχείου (14-bit ADC).
Ακόμα και σε πλήρη ακινησία, το στοιχείο αυτό έχει έναν φυσικό εσωτερικό θόρυβο (offset) που ανεβοκατεβαίνει συνεχώς γύρω από μια μέση τιμή (συνήθως κοντά στο μισό της κλίμακας, π.χ. 8192, ή κοντά στα άκρα ανάλογα με το bias).
Για να ανιχνευτεί κίνηση, πρέπει να υπολογίζεις τη διαφορά (αλγόριθμος DC filter / κατώφλι) μεταξύ των μετρήσεων.
Η Διορθωτική Δοκιμή
Ας κάνουμε δύο πράγματα:
Μεγαλώνουμε το delay για να είμαστε σίγουροι ότι ο nRF52840 προλαβαίνει το παράθυρο DOCI του αισθητήρα.
Αλλάζουμε τη JavaScript ώστε να μην τυπώνει απλά το νούμερο, αλλά να δείχνει ένα μικρό γράφημα (ASCII graph) στην κονσόλα για να δεις οπτικά αν η καμπύλη αντιδρά όταν περνάς το χέρι σου.
Αντικατάστησε τον κώδικα με αυτόν:
javascript
const PIN_OUT = D24;   // P0.24 -> Data
const PIN_PWR = D32;   // P1.00 -> Power

var c = E.compiledC(`
// void initPIR()
// int readPIRRaw()

volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

// Αυξάνουμε τα NOPs για πιο ασφαλές delay ~5-6us στα 64MHz του nRF52840
void delay_5us_nrf() {
    for(volatile int i=0; i<95; i++) {
        __asm("nop");
    }
}

void initPIR() {
    *P1_PIN_CNF_0 = 1;       
    *P1_OUTSET = (1U << 0);  
}

int readPIRRaw() {
    unsigned int value = 0;

    // Start Signal: HIGH για ~110us
    *P0_PIN_CNF_24 = 1; 
    *P0_OUTSET = (1U << 24);
    
    // Πιο σταθερό start delay
    for (volatile int d = 0; d < 1800; d++) {
        __asm("nop");
    }

    // Ανάγνωση 19 bits
    for (unsigned char i = 0; i < 19; i++) {
        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
        delay_5us_nrf();

        *P0_OUTSET = (1U << 24);
        delay_5us_nrf();

        *P0_PIN_CNF_24 = 0; 
        delay_5us_nrf();

        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }

        *P0_PIN_CNF_24 = 1;
        *P0_OUTCLR = (1U << 24);
    }

    *P0_OUTCLR = (1U << 24);
    *P0_PIN_CNF_24 = 1;

    value = (value >> 1);
    value &= 0x3FFF; 

    return (int)value;
}
`);

function startPIRTest() {
  c.initPIR();
  console.log("Αναμονή 3 δευτερολέπτων για σταθεροποίηση...");
  
  setTimeout(function() {
    console.log("Έναρξη. Κούνησε το χέρι σου μπροστά από το μάτι!");
    
    setInterval(function() {
      try {
        var rawVal = c.readPIRRaw();
        
        // Μετατροπή της τιμής (0-16383) σε μια μπάρα 40 χαρακτήρων για οπτικό έλεγχο
        var barLength = Math.floor((rawVal / 16383) * 40);
        if(barLength > 40) barLength = 40;
        if(barLength < 0) barLength = 0;
        var bar = "=".repeat(barLength) + " ".repeat(40 - barLength);
        
        console.log("Val: " + rawVal + " [" + bar + "]");
      } catch(e) {
        console.log("Error: ", e);
      }
    }, 200); // Πιο γρήγορο sampling (200ms) για να προλάβουμε την κίνηση
    
  }, 3000);
}

startPIRTest();
Χρησιμοποιήστε τον κώδικα με προσοχή.
Τι να παρατηρήσεις τώρα:
Όταν υπάρχει απόλυτη ακινησία, η μπάρα [=== ] και το νούμερο θα πρέπει να σταθεροποιηθούν γύρω από μια συγκεκριμένη περιοχή (π.χ. συνέχεια κοντά στο 8000 ή συνέχεια κοντά στο 16000, με πολύ μικρές διακυμάνσεις).
Όταν περάσεις το χέρι σου απότομα, το νούμερο πρέπει να κάνει ένα μεγάλο «σπάσιμο» (π.χ. να πέσει από το 15000 στο 2000 και να ξαναανέβει).
Ανέβασέ το και πες μου: Σταθεροποιείται κάπου η μπάρα όταν δεν κουνιέται τίποτα, ή συνεχίζει να παίζει τρελά από το 0 στο 16000;
Οι απαντήσεις AI μπορεί να περιλαμβάνουν λάθη. Μάθετε περισσότερα




χειροτερο εγινε τωρα, βγαζει μια τιμη μια στς τοσες, μονο του, αλλιως 0

Val: 1536 [===                                     ]
