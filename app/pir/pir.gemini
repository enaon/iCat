Για να σταματάει το stream ακόμα και με το reset της JavaScript, σημαίνει ότι ο αισθητήρας μπαίνει σε μια κατάσταση «μόνιμου timeout» ή «αναμονής» επειδή η δειγματοληψία μας (polling) μέσω του setInterval πέφτει πάνω στη στιγμή που ο αισθητήρας προσπαθεί να κάνει εσωτερικό update, χάνοντας εντελώς τον συγχρονισμό του [1].
Σύμφωνα με το datasheet, ο αισθητήρας παράγει μόνος του το σήμα Interrupt (τραβάει τη γραμμή HIGH) κάθε φορά που έχει νέα δεδομένα (συνήθως κάθε 16ms ή 32ms ανάλογα με τον εσωτερικό του ταλαντωτή).
Η απόλυτη λύση για να μην κολλήσει ποτέ είναι να καταργήσουμε τελείως το setInterval της JavaScript και να αφήσουμε τον nRF52840 να διαβάζει το PIR μόνο όταν ο ίδιος ο αισθητήρας το ζητάει (Hardware Interrupt-driven).
Η Οριστική Λύση: Ανάγνωση Μόνο σε Hardware Interrupt
Με αυτόν τον τρόπο, το Pin είναι μόνιμα Input. Μόλις ο αισθητήρας βγάλει το Interrupt (Rising Edge), ο nRF52840 αντιδρά σε νανοδευτερόλεπτα, τρέχει την Inline C, διαβάζει τα 19 bits, απελευθερώνει τη γραμμή και περιμένει το επόμενο σήμα από τον αισθητήρα. Δεν υπάρχει while loop, άρα δεν υπάρχει καμία πιθανότητα να κολλήσει.
javascript
const PIN_OUT = D24;   // Data (P0.24)
const PIN_PWR = D32;   // Power (P1.00)

var c = E.compiledC(`
// void initPIR()
// int readPIROnInterrupt()

volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

void delay_200ns() {
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
}

void initPIR() {
    *P1_PIN_CNF_0 = 1;       
    *P1_OUTSET = (1U << 0);  // Τροφοδοσία HIGH
    
    // Αρχικά σε Input Mode, No Pull, για να δεχτεί το Interrupt
    *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 
}

int readPIROnInterrupt() {
    unsigned int value = 0;

    // Είμαστε ήδη σε HIGH λόγω του Hardware Interrupt του αισθητήρα.
    // Ξεκινάμε αμέσως τα βήματα ❸ έως ❽ για τα 19 bits:
    for (unsigned char i = 0; i < 19; i++) {
        
        // ❸: Pull LOW
        *P0_PIN_CNF_24 = 1;       // Output
        *P0_OUTCLR = (1U << 24);  // LOW
        delay_200ns();

        // ❹: Rising Edge (HIGH)
        *P0_OUTSET = (1U << 24);  // HIGH
        delay_200ns();

        // ❺ & ❻: Γύρισμα σε INPUT και Sampling
        *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); // Input
        delay_200ns(); 

        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }
    }

    // ❾: Force LOW για τουλάχιστον 64 cycles για ολοκλήρωση του update
    *P0_PIN_CNF_24 = 1;       
    *P0_OUTCLR = (1U << 24);  
    for (volatile int d = 0; d < 200; d++) {
        __asm("nop");
    }
    
    // Επαναφορά σε Input Mode (Release) για να μπορέσει να ξαναγίνει HIGH στο επόμενο update
    *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 

    // Επεξεργασία bits
    value = (value >> 1);
    value &= 0xFFFF; 

    return (int)value;
}
`);

function startPIRStrictInterruptTest() {
  c.initPIR();
  console.log("Αναμονή 4 δευτερολέπτων για σταθεροποίηση...");
  
  setTimeout(function() {
    console.log("Το σύστημα ακούει το Hardware Interrupt του αισθητήρα. Ξεκινήστε την κίνηση:");
    
    // Χρησιμοποιούμε τη setWatch με irq:true. Μόλις ο αισθητήρας ανεβάσει τη γραμμή (rising),
    // εκτελείται ακαριαία η C χωρίς κανένα delay ή setInterval.
    setWatch(function() {
      try {
        var rawVal = c.readPIROnInterrupt();
        
        // Μετατροπή σε signed 16-bit
        var signedVal = (rawVal > 32767) ? rawVal - 65536 : rawVal;

        // Φιλτράρισμα ακραίου θορύβου κατά το reset της γραμμής
        if (signedVal === 0 || signedVal === -1) return;

        // Σχεδίαση μπάρας
        var absVal = Math.abs(signedVal);
        var barLength = Math.floor((absVal / 2500) * 40); 
        if(barLength > 40) barLength = 40;
        var bar = "=".repeat(barLength) + " ".repeat(40 - barLength);
        
        console.log("PIR Filter Output: " + signedVal + " [" + bar + "]");
        
      } catch(e) {
        console.log("Error inside interrupt: ", e);
      }
    }, PIN_OUT, { repeat: true, edge: "rising", irq: true });
    
  }, 4000);
}

startPIRStrictInterruptTest();
