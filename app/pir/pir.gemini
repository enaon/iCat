οχι τωρα μοιαζει να μην εχι σχεση με την κινηση, και νομιζω ειναι 19 βιτ οχι 14 η 16

DOCI interface outputs the value of the high-pass filter. The DOCI output data as shown
in Figure 5 consists of 19 bits, with a 2 bits start code, 16 data bits, and a 1bit  tail.
Έχεις απόλυτο δίκιο! Με βάση και το άρθρο που μου έστειλες στην αρχή, η Senba στέλνει 19 bits συνολικά: 
Bit 18 (το πρώτο): Είναι πάντα 1 (Start code).
Bit 17: Είναι πάντα 0 (Start code).
Bits 16 έως 1: Είναι τα 16 bits των πραγματικών δεδομένων (High-pass Filter output).
Bit 0 (το τελευταίο): Είναι πάντα 0 (Tail bit). 
Επειδή εμείς τρέχαμε τη λούπα 14 ή 16 φορές, ο nRF52840 διάβαζε τα αρχικά "1" και "0" του start code μαζί με ένα κομμένο μέρος των δεδομένων, γι' αυτό οι τιμές έβγαιναν κολλημένες στο 16383 χωρίς λογική.
Η Διόρθωση
Τρέχουμε τη λούπα ακριβώς 19 φορές (όπως λέει το datasheet και το blog).
Απομονώνουμε τα μεσαία 16 bits δεδομένων, κάνοντας Shift δεξιά κατά 1 bit (value >> 1) για να πετάξουμε το tail bit, και εφαρμόζουμε μάσκα 0xFFFF. 

Stack Overflow
 +2
Ορίστε ο διορθωμένος κώδικας για 19-bit:
javascript
const PIN_OUT = D24;   // Data (P0.24)
const PIN_PWR = D32;   // Power (P1.00)

var c = E.compiledC(`
// void initPIR()
// int readPIRInterruptMode()

volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

void delay_200ns() {
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
}

void initPIR() {
    *P1_PIN_CNF_0 = 1;       
    *P1_OUTSET = (1U << 0);  
    *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 
}

int readPIRInterruptMode() {
    unsigned int value = 0;
    
    *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 

    int timeout = 150000;
    while (((*P0_IN >> 24) & 1) == 0) {
        timeout--;
        if (timeout <= 0) return -1; 
    }

    // ΔΙΟΡΘΩΣΗ: Ανάγνωση και των 19 bits
    for (unsigned char i = 0; i < 19; i++) {
        
        // ❸: Pull LOW
        *P0_PIN_CNF_24 = 1;       
        *P0_OUTCLR = (1U << 24);  
        delay_200ns();

        // ❹: Rising Edge (HIGH)
        *P0_OUTSET = (1U << 24);  
        delay_200ns();

        // ❺ & ❻: Γύρισμα σε INPUT και ανάγνωση bit
        *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 
        delay_200ns(); 

        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }
    }

    // ❾: Force LOW και απελευθέρωση
    *P0_PIN_CNF_24 = 1;       
    *P0_OUTCLR = (1U << 24);  
    delay_200ns(); delay_200ns();
    *P0_PIN_CNF_24 = (0 << 0) | (0 << 2); 

    // --- ΕΠΕΞΕΡΓΑΣΙΑ ΤΩΝ 19 BITS ---
    // Πετάμε το bit 0 (tail bit) με shift δεξιά κατά 1
    value = (value >> 1);
    
    // Κρατάμε μόνο τα επόμενα 16 bits δεδομένων (Bits 1-16)
    value &= 0xFFFF; 

    return (int)value;
}
`);

function startPIRInterruptModeTest() {
  c.initPIR();
  console.log("Αναμονή 4 δευτερολέπτων για σταθεροποίηση...");
  
  setTimeout(function() {
    console.log("Έναρξη δειγματοληψίας 19-bit (Κάθε 100ms):");
    
    setInterval(function() {
      try {
        var rawVal = c.readPIRInterruptMode();
        
        if (rawVal === -1) return; 
        
        // Σε κατάσταση ηρεμίας το 16-bit high-pass filter της Senba παίζει κοντά στο 0 ή στο 32768 (mid-scale).
        // Μετατροπή σε short (signed 16-bit) αν το φίλτρο βγάζει αρνητικές τιμές
        var signedVal = (rawVal > 32767) ? rawVal - 65536 : rawVal;

        // Σχεδίαση απλής μπάρας με βάση την απόλυτη τιμή (ένταση κίνησης)
        var absVal = Math.abs(signedVal);
        var barLength = Math.floor((absVal / 2000) * 40); 
        if(barLength > 40) barLength = 40;
        var bar = "=".repeat(barLength) + " ".repeat(40 - barLength);
        
        console.log("Filter Value: " + signedVal + " [" + bar + "]");
        
      } catch(e) {
        console.log("Error: ", e);
      }
    }, 100); 
  }, 4000);
}

startPIRInterruptModeTest();
