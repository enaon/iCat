#ifndef INC_YS332_H_
#define INC_YS332_H_

#include "stm32g0xx_hal.h"

#define PIR_PORT GPIOA
#define PIR_PIN  GPIO_PIN_12

// Input mode
#define PIR_INPUT() \
    (PIR_PORT->MODER &= ~(3U << (12 * 2)))

// Output mode
#define PIR_OUTPUT() \
    do { \
        PIR_PORT->MODER &= ~(3U << (12 * 2)); \
        PIR_PORT->MODER |=  (1U << (12 * 2)); \
    } while (0)

// Drive low
#define PIR_LOW() \
    (PIR_PORT->BSRR = (1U << (12 + 16)))

// Drive high
#define PIR_HIGH() \
    (PIR_PORT->BSRR = (1U << 12))

// Read
#define PIR_READ() \
    ((PIR_PORT->IDR >> 12) & 1)


#define delay_5us() \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \
		__NOP(); \


int16_t PIR_ReadRaw(void);
void vTimingTest_5us(void);



#endif /* INC_YS332_H_ */

https://github.com/maurosmartins/nrf2mqtt/blob/main/firmware/Core/Src/ys332.c

/*
 * ys332.c
 *
 *  Created on: Apr 6, 2026
 *      Author: mauro
 */

#include "ys332.h"

volatile int16_t PIR=0;

int16_t PIR_ReadRaw(void){
    uint32_t value = 0;
    int16_t pirRaw = 0;


    PIR_HIGH();
    PIR_OUTPUT();
    for (volatile int d = 0; d < 18; d++); //~110us


    for (uint8_t i = 0; i < 19; i++)
    {
        //Pull LOW
    	PIR_OUTPUT();
        PIR_LOW();

        delay_5us();

        //Rising edge
        PIR_HIGH();
        delay_5us();

        //wait for DOCI to switch state
		PIR_INPUT();
        delay_5us();

        //Read bit
        value <<= 1;
        if (PIR_READ() == GPIO_PIN_SET){
            value |= 1;
        }

        PIR_OUTPUT();
        PIR_LOW();

    }

    //pull low
    PIR_LOW();
    PIR_OUTPUT();


    value = (value >> 1);
    value &= 0b001111111111111111;

    pirRaw = value;

    return pirRaw;
}

void vTimingTest_5us(void){
	PIR_OUTPUT();
	while(1){
		PIR_LOW();
		delay_5us();
		PIR_HIGH();
		delay_5us();
	}
}

Με αυτα τα δεδομενα, και με τα ππαρακατω:

1). Χρησιμοποιουμε NRF52840
2). Το λογισμικό ειναι Espruino
3). To PIR  Ειναι συνδεδεενο στο NRF,  me to D24  στο OUT του πιρ, και το  D32  στο  power του PIR
4). To Esprino,  Exei δυνατότητα  Inline C :

https://www.espruino.com/InlineC

Inline C code⇠
Normal code for Espruino is written in JavaScript. However for some tasks this won't be fast enough, or you may have existing C code that you wish to use.

In this case, you have a few options:

Insert inline C code into your JS project
Recompile the Espruino firmware with your own C code
Use the IDE to compile your JavaScript code
Use the Inline Assembler
This page covers the first option - follow the links above for other options.

Note: This is an online service that is only provided for official Espruino boards. It won't work on devices like ESP8266 or ESP32.

How do I use it?⇠
You create code of the form var c = E.compiledC in the root scope of your code, giving your C code inside a 'template literal' (using the backtick character at the beginning and end).

var c = E.compiledC(`
// int fibo(int)
int fibo(int n){
 if(n <= 1){
  return n;
 }
 int fibo = 1;
 int fiboPrev = 1;
 for(int i = 2; i < n; ++i){
  int temp = fibo;
  fibo += fiboPrev;
  fiboPrev = temp;
 }
 return fibo;
}
`);

print(c.fibo(20));
The first lines should contain comments that describe the arguments and return value for each function that you wish to export to Espruino, in the same form as used for the Assembler. The variable c will then contain an object containing a field for each exported function.

Interrupts⇠
One of the main uses for Inline C is doing something when an interrupt occurs. You can do this by specifying irq:true when using setWatch:


var c = E.compiledC(`
// void press(bool)
// int get()
volatile int data;
void press(bool state){
  data++;
}
int get() {
 int r = data;
 data = 0;
 return r;
}
`);
// Make `c.press` get called on an IRQ
setWatch(c.press, BTN1, {repeat:true, edge:"both", irq:true});
// Every 10 seconds, report back the value
setInterval(function() {
  print(c.get());
}, 10000);
Note that you can have multiple functions and variables. While Espruino can't access the variables directly, you can write 'getter' functions for them.

Accessing arrays⇠
You'll probably want to use C code to work through large amounts of data quickly. To avoid fragmentation problems, it's not guaranteed that Espruino will always allocate data in one contiguous chunk, so you have two options:

forEach⇠
Use Array/TypedArray.forEach to call your function for each element of the array:

var c = E.compiledC(`
// void hash(int)
// int get()
unsigned int data;
void hash(unsigned int value){
  data = ((data<<1) | (data>>31)) ^ value;
}
int get() {
 int r = data;
 data = 0;
 return r;
}
`);

var arr = new Uint32Array(1000);
// Fill with random data
for (var i in arr) arr[i]=Math.random()*0xFFFFFFFF;
// Feed each data item through in turn
arr.forEach(c.hash);
// Print the result
print(c.get());
Note that you can also use .map, .reduce, .filter, etc.

Direct Access⇠
Large typed arrays (eg. Uint8Array) will always be allocated as Flat Strings if possible, but you can use E.toString to force Espruino to create a
Something went wrong and the content wasn't generated.
δες ξανα λιγο τους χρονους, στο βημα 4 θελει και εκει 200

❶ The microcontroller ignores the YS312 interrupt valid signal and directly pulls DOCI high.
❷ The microcontroller pulls DOCI high for at least two system clock cycles (about 0.0625 ms).
❸ The microcontroller pulls DOCI low for at least 200 ns.
❹ The microcontroller generates a rising edge on the DOCI line, and the high level on the DOCI line is maintained for at least 200ns
❺DOCI line switching state, the output data's MSB.
❻Microcontroller sampling data MSB.
❼ Repeat ❸❹❺❻, microcontroller sampling data next-highest bit.
❽ Repeat ❸❹❺❻, microcontroller sampling data LSB.
❾ After data read completion, the microcontroller forces DOCI low and holds for at least 64 system
clock cycles to complete UART data update. Or as shown in Figure 2, the microcontroller forces DOCI
low and immediately releases the DOCI line to complete automatic data update in interrupt mode.
❿ Repeat ❶, start a new read cycle.
Έχεις απόλυτο δίκιο, ας το διορθώσουμε με βάση την ακριβή ροή των βημάτων ❸, ❹, ❺ και ❻.
Στο Βήμα 4, μόλις δημιουργηθεί η ανερχόμενη ακμή (rising edge), η γραμμή πρέπει να κρατηθεί HIGH για τουλάχιστον 200 ns. Αμέσως μετά, στο Βήμα 5, ο αισθητήρας αλλάζει την κατάσταση της γραμμής (MSB), και στο Βήμα 6 κάνουμε τη δειγματοληψία (Sample).
Για να είμαστε σίγουροι ότι ο nRF52840 (στα 64MHz) δεν τρέχει πιο γρήγορα από το υλικό του αισθητήρα, ρυθμίζουμε τα delays της Inline C ώστε:
Το LOW (Βήμα 3) να διαρκεί ~300 ns (πάνω από 200 ns).
Το HIGH (Βήμα 4) να διαρκεί ~300 ns (πάνω από 200 ns).
Μετά το γύρισμα σε INPUT (Βήματα 5-6), αφήνουμε ακόμα ~200 ns για να προλάβει να σταθεροποιηθεί η τάση που βγάζει το PIR πριν τη διαβάσουμε.
Ορίστε ο πλήρης, διορθωμένος κώδικας για το Espruino Web IDE:
javascript
const PIN_OUT = D24;   // Data (P0.24)
const PIN_PWR = D32;   // Power (P1.00)

var c = E.compiledC(`
// void initPIR()
// int readPIRRaw()

volatile unsigned int *P0_OUTSET     = (volatile unsigned int *)0x50000508UL;
volatile unsigned int *P0_OUTCLR     = (volatile unsigned int *)0x5000050CUL;
volatile unsigned int *P0_IN         = (volatile unsigned int *)0x50000510UL;
volatile unsigned int *P0_PIN_CNF_24 = (volatile unsigned int *)0x50000760UL;

volatile unsigned int *P1_OUTSET     = (volatile unsigned int *)0x50000808UL;
volatile unsigned int *P1_PIN_CNF_0  = (volatile unsigned int *)0x50000A00UL;

// Ασφαλής καθυστέρηση ~300 ns (άνω των 200ns) στα 64MHz
void delay_200ns_safe() {
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
    __asm("nop"); __asm("nop"); __asm("nop"); __asm("nop");
}

// Καθυστέρηση ~70 μs (άνω των 62.5μs) για το Start Signal
void delay_62us() {
    for (volatile int i = 0; i < 900; i++) {
        __asm("nop");
    }
}

void initPIR() {
    *P1_PIN_CNF_0 = 1;       // P1.00 ως Output
    *P1_OUTSET = (1U << 0);  // Τροφοδοσία HIGH
}

int readPIRRaw() {
    unsigned int value = 0;

    // ❶ & ❷: Pull DOCI high και κράτα το για τουλάχιστον 0.0625 ms (~62.5 μs)
    *P0_PIN_CNF_24 = 1;       // Output Mode
    *P0_OUTSET = (1U << 24);  // Drive HIGH
    delay_62us();

    // Ανάγνωση των 14 bits (MSB προς LSB)
    for (unsigned char i = 0; i < 14; i++) {
        
        // ❸: Pull DOCI low για τουλάχιστον 200 ns
        *P0_PIN_CNF_24 = 1;       // Διασφάλιση Output Mode
        *P0_OUTCLR = (1U << 24);  // Drive LOW
        delay_200ns_safe();

        // ❹: Rising edge και διατήρηση του HIGH για τουλάχιστον 200 ns
        *P0_OUTSET = (1U << 24);  // Drive HIGH (Rising Edge)
        delay_200ns_safe();       // Κράτημα HIGH για >200ns

        // ❺ & ❻: Γύρισμα σε INPUT (Sample Phase)
        *P0_PIN_CNF_24 = 0;       // Input mode, no pull
        delay_200ns_safe();       // Μικρή αναμονή να οδηγήσει τη γραμμή το PIR (Βήμα 5)

        // Δειγματοληψία bit (Βήμα 6)
        value <<= 1;
        if ((*P0_IN >> 24) & 1) {
            value |= 1;
        }
    }

    // ❾: Ολοκλήρωση ανάγνωσης. Force DOCI low για τουλάχιστον 64 κύκλους
    *P0_PIN_CNF_24 = 1;       // Επαναφορά σε Output Mode
    *P0_OUTCLR = (1U << 24);  // Force LOW
    
    // Κράτημα LOW για ~2 μs (υπερκαλύπτει τους 64 κύκλους του αισθητήρα)
    for (volatile int d = 0; d < 30; d++) {
        __asm("nop");
    }

    // Απελευθέρωση γραμμής (Release)
    *P0_PIN_CNF_24 = 0;       // Γύρισμα σε Input

    return (int)value;
}
`);

function startPIRTest() {
  c.initPIR();
  console.log("Αναμονή 4 δευτερολέπτων για σταθεροποίηση του YS312/332...");
  
  setTimeout(function() {
    console.log("Έναρξη ανάγνωσης (Κάθε 250ms):");
    
    setInterval(function() {
      try {
        var rawVal = c.readPIRRaw();
        
        // Σχεδίαση μπάρας (0 έως 16383)
        var barLength = Math.floor((rawVal / 16383) * 40);
        if(barLength > 40) barLength = 40;
        if(barLength < 0) barLength = 0;
        var bar = "=".repeat(barLength) + " ".repeat(40 - barLength);
        
        console.log("Raw ADC: " + rawVal + " [" + bar + "]");
      } catch(e) {
        console.log("Error: ", e);
      }
    }, 250);
  }, 4000);
}

startPIRTest();
